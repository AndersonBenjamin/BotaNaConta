# Copie este arquivo para .env e preencha os valores. Usado pelo docker-compose.yml.
# Nunca versione o .env.

# ---- Banco ----
POSTGRES_USER=gastos
# Use só letras e números: a senha entra na URL de conexão do banco.
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=gastos
# Porta do banco na máquina (127.0.0.1). Altere se a 5432 já estiver em uso.
POSTGRES_PORT=5432

# ---- API ----
# Mínimo de 32 caracteres. Gere com: openssl rand -hex 48
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d
APP_TIMEZONE=America/Sao_Paulo

# ---- Aplicação ----
# Porta local (127.0.0.1) em que o app fica disponível para o Nginx da VPS.
APP_PORT=8080

# ---- Usuário inicial (usado pelo seed) ----
SEED_USER_NAME=Anderson
SEED_USER_EMAIL=usuario@email.com
SEED_USER_PASSWORD=troque-esta-senha
