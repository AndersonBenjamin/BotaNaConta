# Copie este arquivo para backend/.env para rodar o backend localmente (fora do Docker).
# Os dados do banco devem bater com o .env da raiz.

DATABASE_URL=postgresql://gastos:troque-esta-senha@localhost:5432/gastos

# API
PORT=3000
# Mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d
# Origens liberadas no CORS, separadas por vírgula. Deixe vazio quando frontend e API estiverem no mesmo domínio.
CORS_ORIGIN=http://localhost:5173
# Fuso usado para calcular "hoje" e "este mês".
APP_TIMEZONE=America/Sao_Paulo

# Usuário inicial (usado pelo seed)
SEED_USER_NAME=Anderson
SEED_USER_EMAIL=usuario@email.com
SEED_USER_PASSWORD=troque-esta-senha
